{
  "name": "@chenlongapps/opencode-token-usage",
  "version": "0.4.1",
  "description": "Session-tree token usage, live performance, context window and estimated cost for OpenCode 2",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "token-usage",
    "context-window",
    "tps",
    "ttft",
    "cost"
  ],
  "homepage": "https://github.com/chenlongapps/opencode-token-usage#readme",
  "bugs": {
    "url": "https://github.com/chenlongapps/opencode-token-usage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenlongapps/opencode-token-usage.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "tui.js",
    "dist",
    "README.md",
    "ROADMAP.md",
    "docs/pricing.md",
    "docs/verification.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:smoke": "node scripts/smoke.mjs",
    "release:patch": "npm version patch",
    "prepublishOnly": "npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.11"
  },
  "peerDependencies": {
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@opencode/client": "2.0.11",
    "@opencode/schema": "2.0.11",
    "@opencode/theme": "2.0.11",
    "@opentui/core": "0.5.10",
    "@opentui/solid": "0.5.10",
    "@types/node": "^22.0.0",
    "@xterm/headless": "6.0.0",
    "babel-preset-solid": "1.9.12",
    "solid-js": "1.9.12",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "packageManager": "npm@10.9.8"
}
