{
  "name": "@chenlongapps/opencode-token-usage",
  "version": "0.4.26",
  "description": "OpenCode 2 plugin for session-tree token usage, context window monitoring, estimated costs, and performance metrics (TPS, TTFT, run time).",
  "keywords": [
    "opencode",
    "opencode-plugin",
    "token-usage",
    "context-window",
    "cost-tracking",
    "tps",
    "ttft",
    "subagents",
    "terminal-ui",
    "llm"
  ],
  "homepage": "https://github.com/chenlongapps/opencode-token-usage#readme",
  "bugs": {
    "url": "https://github.com/chenlongapps/opencode-token-usage/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chenlongapps/opencode-token-usage.git"
  },
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "index.js",
    "tui.js",
    "dist",
    "README.md",
    "ROADMAP.md",
    "docs/pricing.md",
    "docs/verification.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./tui": {
      "types": "./dist/tui.d.ts",
      "import": "./dist/tui.js"
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "npm run lint -- --fix",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/*.test.ts test/*.test.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "prices:update": "tsx scripts/update-prices.ts",
    "release:patch": "npm version patch",
    "prepublishOnly": "npm run lint && npm run typecheck && npm test",
    "prepack": "npm run build"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "@opencode/plugin": "2.3.0"
  },
  "peerDependencies": {
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@babel/core": "^7.28.0",
    "@eslint/js": "^10.0.1",
    "@opencode/client": "2.3.0",
    "@opencode/schema": "2.3.0",
    "@opencode/theme": "2.3.0",
    "@opentui/core": "0.8.4",
    "@opentui/solid": "0.8.4",
    "@types/node": "^22.0.0",
    "@xterm/headless": "6.0.0",
    "babel-preset-solid": "1.9.16",
    "eslint": "^10.15.0",
    "globals": "^17.14.0",
    "solid-js": "1.9.16",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.73.0"
  },
  "packageManager": "npm@10.9.8"
}
